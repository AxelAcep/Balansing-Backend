generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Definisikan enum untuk tipe stunting
enum StuntingType {
  SangatPendek
  Pendek
  Normal
  Tinggi
}

model User {
  email      String     @id
  id         String
  jenis      String

  kader      Kader?     @relation("KaderUser")
  ibuRumah   IbuRumah?  @relation("IbuUser")
}

model Kader {
  id              String      @id @default(cuid())
  email           String      @unique
  namaPuskesmas   String
  namaPosyandu    String
  provinsi        String
  kota            String
  kecamatan       String
  kelurahan       String
  rt              String
  rw              String
  kodePos         String?

  user            User        @relation("KaderUser", fields: [email], references: [email])
  anakKader       AnakKader[]
}

model IbuRumah {
  id          String      @id @default(cuid())
  email       String      @unique
  provinsi    String
  nama        String
  kota        String
  kecamatan   String
  kelurahan   String
  rt          String
  rw          String
  kodePos     String?
  alamat      String
  usia        Int
  noTelp      String
  cekAnak     DateTime?

  user        User        @relation("IbuUser", fields: [email], references: [email])
  anakAnak    AnakIbu[]
}

model AnakIbu {
  id            String       @id @default(cuid())
  emailIbu      String
  nama          String
  usia          DateTime
  beratBadan    Float
  tinggiBadan   Float
  stunting      StuntingType // Ganti tipe data stunting menjadi enum
  anemia        Boolean
  jenisKelamin  String
  cekMingguan   Boolean  @default(false)
  zscore        Float?
  

  ibu           IbuRumah     @relation(fields: [emailIbu], references: [email])

  recapAnak       RecapAnak[] 
}

model AnakKader {
  id                    String       @id @default(cuid())
  nama                  String
  namaIbu               String
  usia                  Int
  beratBadan            Float
  tinggiBadan           Float
  anemia                Boolean
  stunting              StuntingType // Ganti tipe data stunting menjadi enum
  jenisKelamin          String
  tanggal               DateTime?
  konjungtivitaNormal   Boolean?
  kukuBersih            Boolean?
  tampakLemas           Boolean?
  tampakPucat           Boolean?
  riwayatAnemia         Boolean?
  
  kaderEmail            String
  kader                 Kader        @relation(fields: [kaderEmail], references: [email])
}

model RecapAnak {
  kodeRecap            String           @id @default(cuid())
  anakIbuId            String
  tanggal              DateTime
  beratBadan           Float
  tinggiBadan          Float
  usia                 Int
  anemia               Boolean
  stunting             StuntingType
  konjungtivitasNormal Boolean
  kukuBersih           Boolean
  riwayatAnemia        Boolean
  tampakLemas          Boolean
  tampakPucat          Boolean
  rekomendasi          String

  anakIbu AnakIbu @relation(fields: [anakIbuId], references: [id])
}